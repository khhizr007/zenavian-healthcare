# Copy to .dev.vars for local `npm run pages:dev`. In production set these in Cloudflare Pages > Settings > Environment variables.
# NEVER commit real values.

# Build-time (public) values
SITE_URL=https://www.example.com
PUBLIC_TURNSTILE_SITE_KEY=

# Runtime secrets (Pages Functions)
RESEND_API_KEY=
TURNSTILE_SECRET=
NOTIFY_EMAIL=info@example.com
FROM_EMAIL="ZenAvian Healthcare <noreply@example.com>"
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Local development ONLY: skip Turnstile. Do not set in production.
# ALLOW_NO_TURNSTILE=1
