---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { pages, type PageKey } from '@/config/pages';
import { pagePaths } from '@/config/pages';
interface Props {
  page: PageKey;
  heading: string;
  draft?: boolean;
}
const { page, heading, draft = false } = Astro.props;
const crumbs = [{ label: heading, href: pagePaths[page] }];
---

<BaseLayout
  title={pages[page].title}
  description={pages[page].description}
  ogImage={`/og/${page}.png`}
  breadcrumbs={crumbs}
>
  <PageHeader title={heading} crumbs={crumbs} />
  <section class="section">
    <div class="container-x max-w-3xl">
      {draft && (
        <p class="mb-8 rounded-xl border-2 border-sky-700 bg-mist-50 p-4 font-semibold text-deep">
          Draft - to be reviewed by legal counsel.
        </p>
      )}
      <div class="prose-zen [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-extrabold [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
