---
// Print-styled route rendered to PDF by scripts/build-catalogue.mjs (A4). Not indexed, not in sitemap.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, has, hasAddress, formattedAddress } from '@/config/site';
import { getProducts, LABEL_REFERENCE_TEXT } from '@/lib/products';
const products = await getProducts();
---

<BaseLayout title="ZenAvian Healthcare Catalogue" description="Print catalogue" noindex bare>
  <style is:global>
    @page {
      size: A4;
      margin: 0;
    }
    body {
      background: #fff;
    }
    .pg {
      width: 210mm;
      height: 297mm;
      padding: 22mm 20mm;
      box-sizing: border-box;
      page-break-after: always;
      overflow: hidden;
      position: relative;
    }
    .pg:last-child {
      page-break-after: auto;
    }
    .cover {
      background: linear-gradient(160deg, #f0f9ff, #e0f2fe 60%, #fff);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .back {
      background: #0a2a66;
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    .pg h1 {
      font-size: 40pt;
    }
    .pg h2 {
      font-size: 24pt;
      margin-bottom: 8mm;
    }
    .pg p,
    .pg li {
      font-size: 11.5pt;
      line-height: 1.6;
    }
    .pg ul {
      list-style: disc;
      padding-left: 6mm;
      margin: 3mm 0;
    }
    .pg table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6mm;
      font-size: 11pt;
    }
    .pg th,
    .pg td {
      text-align: left;
      padding: 2.5mm 3mm;
      border-bottom: 1px solid #bae6fd;
      vertical-align: top;
    }
    .pg th {
      width: 38%;
      color: #0a2a66;
    }
    .badge {
      display: inline-block;
      background: #e0f2fe;
      color: #0a2a66;
      padding: 1.5mm 4mm;
      border-radius: 99px;
      font-weight: 700;
      font-size: 10pt;
    }
    .note {
      margin-top: 8mm;
      padding: 4mm;
      border: 1.5px solid #0369a1;
      border-radius: 3mm;
      font-size: 10.5pt;
    }
  </style>

  <section class="pg cover">
    <img
      src={site.logo.svg}
      alt="ZenAvian Healthcare"
      width="320"
      height="57"
      style="width:80mm;height:auto"
    />
    <h1 style="margin-top:20mm">Product Catalogue</h1>
    <p style="font-size:16pt;color:#0369A1;margin-top:4mm">{site.tagline}</p>
    <p style="margin-top:40mm;color:#475569">
      {site.catalogue.version} | {site.catalogue.date}
    </p>
  </section>

  <section class="pg">
    <h2>About ZenAvian Healthcare</h2>
    <p>
      ZenAvian Healthcare is a poultry-focused healthcare company dedicated to supporting poultry
      farmers, veterinarians and the wider poultry industry with dependable veterinary
      pharmaceutical and nutritional solutions.
    </p>
    <p>
      We focus on developing and delivering products that address real farm challenges, combining
      the expertise of international manufacturing partners with a strong understanding of the
      Indian poultry market.
    </p>
    <h2 style="margin-top:10mm">Quality You Can Trust</h2>
    <p>
      We work with carefully selected international manufacturing partners to source reliable
      poultry healthcare products, handled according to applicable quality and regulatory
      requirements.
    </p>
    <ul>
      <li>Selection of reliable manufacturing partners</li>
      <li>Quality-assured raw materials and finished products</li>
      <li>Consistent product quality</li>
      <li>Proper packaging and storage</li>
      <li>Batch-wise documentation and quality checks</li>
      <li>Compliance with applicable regulatory requirements</li>
    </ul>
  </section>

  {products.map((p) => (
    <section class="pg">
      <span class="badge">{p.data.category}</span>
      <h2 style="margin-top:5mm;margin-bottom:2mm">{p.data.name}</h2>
      <p style="color:#0369A1;font-weight:700">{p.data.tagline}</p>
      <p style="margin-top:5mm">{p.data.summary}</p>
      <h3 style="margin-top:8mm;font-weight:700;color:#0A2A66">Key focus</h3>
      <ul>
        {p.data.keyPoints.map((k) => (
          <li>{k}</li>
        ))}
      </ul>
      {p.data.educationalNote && <p>{p.data.educationalNote}</p>}
      <table>
        <tbody>
          <tr>
            <th>Target</th>
            <td>{p.data.targetSpecies.join(', ')}</td>
          </tr>
          <tr>
            <th>Category</th>
            <td>{p.data.category}</td>
          </tr>
          {p.data.composition && (
            <tr>
              <th>Composition</th>
              <td>{p.data.composition}</td>
            </tr>
          )}
          {p.data.dosage && (
            <tr>
              <th>Dosage</th>
              <td>{p.data.dosage}</td>
            </tr>
          )}
          {p.data.withdrawalPeriod && (
            <tr>
              <th>Withdrawal period</th>
              <td>{p.data.withdrawalPeriod}</td>
            </tr>
          )}
          {p.data.packSizes && (
            <tr>
              <th>Pack sizes</th>
              <td>{p.data.packSizes}</td>
            </tr>
          )}
        </tbody>
      </table>
      <p class="note">
        {LABEL_REFERENCE_TEXT} For animal use only. Use as per the approved label and veterinary
        advice.
      </p>
    </section>
  ))}

  <section class="pg">
    <h2>Contact</h2>
    <p>
      <strong>{site.name}</strong>
    </p>
    {hasAddress() && <p>{formattedAddress()}</p>}
    {has(site.phone) && <p>Phone: {site.phone}</p>}
    {has(site.email) && <p>Email: {site.email}</p>}
    <p>Web: {site.domain.startsWith('TODO') ? '' : site.domain}</p>
    <p class="note">
      Information in this catalogue is for general awareness. Products must be used only as per the
      approved label and veterinary advice. Product images may differ from actual packs.
    </p>
  </section>

  <section class="pg back">
    <img src={site.logo.mark} alt="" width="120" height="120" />
    <p style="font-size:22pt;font-weight:800;margin-top:10mm;color:#fff">ZenAvian Healthcare</p>
    <p style="font-size:14pt;color:#E0F2FE">{site.tagline}</p>
  </section>
</BaseLayout>
