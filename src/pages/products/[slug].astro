---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpecTable from '@/components/SpecTable.astro';
import ProductCard from '@/components/ProductCard.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import Icon from '@/components/Icon.astro';
import { getProducts, productImage } from '@/lib/products';
import { productSchema } from '@/lib/seo';
import { emailHref } from '@/config/site';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}
const { product, all } = Astro.props;
const p = product.data;
const img = productImage(product.id);
const related = p.related.map((id) => all.find((x) => x.id === id)).filter((x) => x !== undefined);
const crumbs = [
  { label: 'Products', href: '/products' },
  { label: p.name, href: `/products/${product.id}` },
];
const mail = emailHref(`Enquiry about ${p.name}`);
---

<BaseLayout
  title={p.seoTitle}
  description={p.seoDescription}
  ogImage={`/og/products/${product.id}.png`}
  breadcrumbs={crumbs}
  schema={[
    productSchema({ slug: product.id, name: p.name, summary: p.summary, category: p.category }),
  ]}
>
  <section class="bg-mist molecule-bg border-b border-sky-100">
    <div class="container-x py-10 sm:py-14">
      <Breadcrumbs items={crumbs} />
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="inline-block rounded-full bg-white px-3 py-1 text-sm font-bold text-deep shadow-[var(--shadow-soft)]">
            {p.category}
          </p>
          <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">{p.name}</h1>
          <p class="mt-2 text-xl font-semibold text-sky-700">{p.tagline}</p>
          <p class="mt-5 max-w-xl text-lg">{p.summary}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <WhatsAppButton
              inline
              message={`Hello ZenAvian Healthcare, I would like to know more about ${p.name}.`}
              label={`Ask about ${p.name} on WhatsApp`}
            />
            <a
              class="btn-primary"
              href={`/distributor-enquiry?product=${encodeURIComponent(p.name)}`}
            >
              Make an enquiry
            </a>
          </div>
        </div>
        <div>
          <img
            src={img.src}
            width="800"
            height="600"
            alt={img.isPlaceholder ? `Temporary placeholder image for ${p.name}` : `${p.name} pack`}
            fetchpriority="high"
            class="w-full rounded-[16px] border border-sky-100 bg-white shadow-[var(--shadow-soft)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-extrabold">Key focus</h2>
        <ul class="mt-4 space-y-3">
          {p.keyPoints.map((k) => (
            <li class="flex gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-sky-700" />
              <span>{k}</span>
            </li>
          ))}
        </ul>
        {p.educationalNote && (
          <div class="mt-8 rounded-[16px] bg-mist-50 p-5">
            <h3 class="text-lg font-bold">Good to know</h3>
            <p class="mt-2">{p.educationalNote}</p>
          </div>
        )}
        {p.labelNote && <p class="mt-6 text-muted">{p.labelNote}</p>}
      </div>

      <div class="space-y-6 lg:col-span-2">
        <div>
          <h2 class="mb-4 text-2xl font-extrabold">Product details</h2>
          <SpecTable product={product} />
        </div>
        <div class="rounded-[16px] border-2 border-sky-700 bg-white p-5">
          <h2 class="flex items-center gap-2 text-lg font-bold">
            <Icon name="circle-alert" size={22} class="text-sky-700" /> Important information
          </h2>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm">
            <li>Use only as per the approved product label.</li>
            <li>Seek guidance from a qualified veterinarian before use.</li>
            <li>Follow the withdrawal period stated on the label.</li>
            <li>For animal use only.</li>
          </ul>
          <p class="mt-3 text-sm">
            Seen an unexpected effect?{' '}
            <a class="font-semibold text-sky-700 underline" href="/report-adverse-event">
              Report an adverse event
            </a>
            .
          </p>
        </div>
        {p.brochurePdf && (
          <DownloadButton
            href={p.brochurePdf}
            label="Download product sheet"
            meta="PDF"
            track={`sheet-${product.id}`}
          />
        )}
        {mail && (
          <p class="text-sm">
            <a class="font-semibold text-sky-700 underline" href={mail}>
              Email us about {p.name}
            </a>
          </p>
        )}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-mist section">
      <div class="container-x">
        <h2 class="mb-8 text-3xl font-extrabold">Related products</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <ProductCard product={r!} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
