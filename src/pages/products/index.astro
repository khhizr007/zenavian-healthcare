---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProductCard from '@/components/ProductCard.astro';
import { pages } from '@/config/pages';
import { getProducts } from '@/lib/products';

const products = await getProducts();
const categories = [...new Set(products.map((p) => p.data.category))];
const species = [...new Set(products.flatMap((p) => p.data.targetSpecies))];
const crumbs = [{ label: 'Products', href: '/products' }];
---

<BaseLayout
  title={pages.products.title}
  description={pages.products.description}
  ogImage="/og/products.png"
  breadcrumbs={crumbs}
>
  <PageHeader
    title="Our Products"
    intro="Poultry healthcare products from ZenAvian Healthcare. Composition, dosage and withdrawal period are as approved on the product label."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container-x">
      <div class="mb-8 hidden space-y-4" data-filters>
        <div role="group" aria-labelledby="f-cat">
          <p id="f-cat" class="label">
            Category
          </p>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              class="chip"
              data-group="category"
              data-value=""
              aria-pressed="true"
            >
              All
            </button>
            {categories.map((c) => (
              <button
                type="button"
                class="chip"
                data-group="category"
                data-value={c}
                aria-pressed="false"
              >
                {c}
              </button>
            ))}
          </div>
        </div>
        {species.length > 1 && (
          <div role="group" aria-labelledby="f-sp">
            <p id="f-sp" class="label">
              Target species
            </p>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                class="chip"
                data-group="species"
                data-value=""
                aria-pressed="true"
              >
                All
              </button>
              {species.map((s) => (
                <button
                  type="button"
                  class="chip"
                  data-group="species"
                  data-value={s}
                  aria-pressed="false"
                >
                  {s}
                </button>
              ))}
            </div>
          </div>
        )}
        <p class="text-sm text-muted" role="status" aria-live="polite" data-count></p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-grid>
        {products.map((p, i) => (
          <ProductCard product={p} lazy={i > 3} />
        ))}
      </div>
      <p class="mt-6 hidden rounded-xl bg-mist-50 p-4" data-empty>
        No products match these filters.{' '}
        <button type="button" class="font-semibold text-sky-700 underline" data-reset>
          Clear filters
        </button>
      </p>
    </div>
  </section>

  <section class="on-dark bg-deep py-14 text-center">
    <div class="container-x">
      <p class="font-display text-2xl font-extrabold text-white sm:text-3xl">
        ZenAvian Healthcare - Focused on Poultry. Committed to Quality.
      </p>
      <p class="mt-3 text-lg text-sky-100">Cox Zen | Pulmo Zen | Bact-T Drop | Allbact-Z</p>
      <p class="mt-2 text-sky-100">Quality Products - Scientific Approach - Reliable Partnership</p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .chip {
    min-height: 3rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 2px solid var(--color-sky-700);
    background: #fff;
    color: var(--color-sky-700);
    font-weight: 600;
  }
  .chip[aria-pressed='true'] {
    background: var(--color-sky-700);
    color: #fff;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-product]')];
  if (root) {
    root.classList.remove('hidden');
    const state = { category: '', species: '' };
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const apply = () => {
      let shown = 0;
      cards.forEach((c) => {
        const ok =
          (!state.category || c.dataset.category === state.category) &&
          (!state.species || (c.dataset.species ?? '').split('|').includes(state.species));
        c.hidden = !ok;
        if (ok) shown++;
      });
      count.textContent = `Showing ${shown} of ${cards.length} products`;
      empty.classList.toggle('hidden', shown > 0);
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!b) return;
      const g = b.dataset.group as 'category' | 'species';
      state[g] = b.dataset.value ?? '';
      root
        .querySelectorAll<HTMLButtonElement>(`.chip[data-group="${g}"]`)
        .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    });
    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      state.category = state.species = '';
      root
        .querySelectorAll<HTMLButtonElement>('.chip')
        .forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.value === '')));
      apply();
    });
    apply();
  }
</script>
