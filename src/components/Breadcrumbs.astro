---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    <li>
      <a class="inline-flex min-h-8 items-center text-sky-700 underline" href="/">
        Home
      </a>
    </li>
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {it.href && i < items.length - 1 ? (
          <a class="inline-flex min-h-8 items-center text-sky-700 underline" href={it.href}>
            {it.label}
          </a>
        ) : (
          <span aria-current="page" class="font-medium text-deep">
            {it.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
