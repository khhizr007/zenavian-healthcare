---
import Icon from './Icon.astro';
interface Props {
  icon: string;
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---

<div class="card reveal text-center">
  <span class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full bg-mist-100 text-sky-700">
    <Icon name={icon} size={28} />
  </span>
  <h3 class="text-xl font-bold">{title}</h3>
  <p class="mt-2 text-sm text-muted">{text}</p>
</div>
