---
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---

<section class="bg-mist molecule-bg overflow-hidden">
  <div class="container-x grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2">
    <div>
      <h1 class="text-4xl font-extrabold sm:text-5xl lg:text-[3.25rem]">{title}</h1>
      <p class="mt-5 max-w-xl text-lg text-ink">{text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/products" class="btn-primary">
          Explore Products
        </a>
        <a href="/distributor-enquiry" class="btn-outline">
          Become a Distributor
        </a>
      </div>
    </div>
    <div>
      <img
        src="/images/hero-illustration.svg"
        width="640"
        height="460"
        alt="Illustration of a poultry house, a laboratory flask and a bird"
        fetchpriority="high"
        decoding="async"
        class="mx-auto h-auto w-full max-w-lg"
      />
    </div>
  </div>
</section>
