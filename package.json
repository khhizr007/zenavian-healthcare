{
  "name": "zenavian-healthcare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/apply-override.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "build:catalogue": "node scripts/build-catalogue.mjs",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "test": "playwright test",
    "lhci": "lhci autorun",
    "pages:dev": "astro build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "5.18.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "lucide-static": "1.55.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "wrangler": "4.149.0"
  }
}
